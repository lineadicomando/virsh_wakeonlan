[Unit]
Description=Wake-on-LAN Virsh Listener
# The libvirt networks set to autostart come up when the network daemon starts.
# Where it is socket-activated nothing starts it at boot, the bridges do not
# exist and a packet sent to their broadcast address leaves through the default
# route instead of reaching this listener.
Wants=virtnetworkd.service
After=network.target virtnetworkd.service libvirtd.service

[Service]
ExecStart=/usr/local/bin/virsh_wakeonlan_listener.py
Restart=always
User=root
WorkingDirectory=/usr/local/bin/
SyslogIdentifier=wol_virsh

[Install]
WantedBy=multi-user.target
